{
  "workspace": [
    "./packages/*",
    "./benchmarks/*"
  ],
  "exclude": [
    "**/.tmp/**",
    "**/.bastest/**",
    "**/dist/**",
    "target/**"
  ],
  "tasks": {
    "build": "deno task --cwd packages/bastest build",
    "build:npm": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build-npm.ts",
    "publish:preview": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run npm:pkg-pr-new@0.0.75 publish --no-compact --bin --comment=update './dist/bastest' './dist/@bastest/*'",
    "build:rust": "cargo build --release -p bastest",
    "format": "deno fmt && cargo fmt -p bastest",
    "format:check": "deno fmt --check && cargo fmt -p bastest -- --check",
    "lint": "deno lint && cargo clippy -p bastest --all-targets -- -D warnings",
    "lint:check": "deno lint && cargo clippy -p bastest --all-targets -- -D warnings",
    "typecheck": "deno task --cwd packages/bastest typecheck",
    "test": "deno task --cwd packages/bastest test",
    "bench:initial-run": "deno task --cwd benchmarks/initial-run bench",
    "bench:in-source-test": "deno task --cwd benchmarks/in-source-test bench",
    "clean": "deno task --cwd packages/bastest clean"
  },
  "nodeModulesDir": "auto",
  "catalog": {
    "@types/node": "26.1.0",
    "tsdown": "0.22.3",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "4.1.10"
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "imports": {
    "dax": "npm:dax@0.48.3",
    "npm": "npm:npm@11.18.0",
    "pkg-pr-new": "npm:pkg-pr-new@0.0.75",
    "vitest": "npm:vitest@4.1.10"
  }
}
